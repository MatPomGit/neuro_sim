# Informuje edytor, że jest to najwyższy plik konfiguracyjny
root = true

# Ustawienia dla wszystkich plików
[*] end_of_line = lf

[*.py]
indent_style = space # Określa, czy edytor ma używać spacji, czy tabulatorów.
indent_size = 4 # Standardowa szerokość wcięcia (często stosowana w Pythonie).
charset = utf-8 # Wymusza kodowanie znaków, co zapobiega problemom z wyświetlaniem polskich liter.
trim_trailing_whitespace = true # Automatycznie usuwa spacje na końcach linii podczas zapisu.
insert_final_newline = true # Zapewnia, że każdy plik kończy się pustą linią (częsty wymóg standardów POSIX i linterów).

# Podczas gdy .gitattributes normalizuje pliki podczas przesyłania do repozytorium,
# .editorconfig działa bezpośrednio w edytorze,
# co zapobiega powstawaniu niezgodności już na etapie pisania kodu


### Dlaczego warto to zrobić?

# 1.  **Rozwiązanie problemów lokalnych:**
# Plik `.gitattributes` dba o to, co trafia do zdalnego repozytorium,
# ale nie zawsze zmienia końce linii w istniejących kopiach roboczych na systemie Windows [3].
# `.editorconfig` zapewnia, że każda nowa linia i każdy nowy plik tworzony przez programistę
# będzie miał format **LF** (lub inny wybrany).

# 2.  **Zgodność z linterami:**
# Narzędzia takie jak ESLint czy Prettier mogą zgłaszać błędy,
# gdy wykryją znaki **CR** (Carriage Return) w systemie Windows [1].
# Wymuszenie `end_of_line = lf` w edytorze pozwala uniknąć tych komunikatów.


# 3.  **Niezależność od edytora:**
# `.editorconfig` jest formatem niezależnym od konkretnego programu,
# co pozwala na zachowanie spójności formatowania w całym zespole,
# nawet jeśli programiści korzystają z różnych narzędzi.

# **Podsumowując:** Podczas gdy Git (poprzez `.gitattributes`) pełni rolę "strażnika" repozytorium, 
# `.editorconfig` działa prewencyjnie, dbając o to, by pliki były poprawnie sformatowane 
# już w momencie ich zapisywania na dysku.

